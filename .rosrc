# ROS 2 helpers. Override ROS_WORKSPACE / DOTFILES_ROS_DISTRO in ~/.bashrc.local.
# Installed as ~/.rosrc; loading this file alone does not activate an environment.

_ros_validate_workspace() {
  local workspace
  workspace=$(builtin cd -- "$1" 2>/dev/null && pwd -P) || {
    printf 'ROS workspace does not exist: %s\n' "$1" >&2
    return 1
  }
  if [[ $workspace == / || $workspace == "$(builtin cd -- "$HOME" && pwd -P)" || ! -d $workspace/src ]]; then
    printf 'Expected a dedicated ROS workspace with a src directory: %s\n' "$workspace" >&2
    return 1
  fi
  printf '%s\n' "$workspace"
}

_ros_workspace() {
  local candidate
  if [[ -n ${ROS_WORKSPACE:-} ]]; then
    _ros_validate_workspace "$ROS_WORKSPACE"
    return
  fi
  candidate=$(pwd -P) || return
  while [[ $candidate != / && ! -d $candidate/src ]]; do
    candidate=${candidate%/*}
    [[ -n $candidate ]] || candidate=/
  done
  _ros_validate_workspace "$candidate"
}

ros_env() {
  local selected=${DOTFILES_ROS_DISTRO:-jazzy} root=${DOTFILES_ROS_ROOT:-/opt/ros} workspace
  if (( $# > 1 )) || [[ ! $selected =~ ^[a-z][a-z0-9]*$ ]]; then
    printf 'Usage: ros_env [workspace]; DOTFILES_ROS_DISTRO must name one ROS 2 distribution.\n' >&2
    return 2
  fi
  if [[ ${ROS_VERSION:-2} != 2 || ( -n ${ROS_DISTRO:-} && $ROS_DISTRO != "$selected" ) ]]; then
    printf 'Refusing to mix ROS environments (%s -> %s). Open a fresh shell.\n' "${ROS_DISTRO:-ROS 1}" "$selected" >&2
    return 1
  fi
  if [[ ! -r $root/$selected/setup.bash ]]; then
    printf 'ROS 2 setup not found: %s/%s/setup.bash\n' "$root" "$selected" >&2
    return 1
  fi
  if (( $# == 1 )); then
    workspace=$(_ros_validate_workspace "$1") || return
    if [[ ! -r $workspace/install/local_setup.bash ]]; then
      printf 'Build the workspace before sourcing its overlay: %s\n' "$workspace" >&2
      return 1
    fi
  fi
  source "$root/$selected/setup.bash" || return
  if [[ -n ${workspace:-} ]]; then
    source "$workspace/install/local_setup.bash"
  fi
}

# Subshells keep the caller's directory and overlay environment unchanged.
ros_build() (
  local workspace
  workspace=$(_ros_workspace) || return
  builtin cd -- "$workspace" || return
  ros_env || return
  command colcon build --symlink-install "$@"
)

ros_test() (
  local workspace result=0
  workspace=$(_ros_workspace) || return
  builtin cd -- "$workspace" || return
  ros_env || return
  command colcon test "$@" || result=$?
  command colcon test-result --verbose || return
  return "$result"
)

ros_deps() (
  local workspace
  workspace=$(_ros_workspace) || return
  builtin cd -- "$workspace" || return
  ros_env || return
  command rosdep install --from-paths src --ignore-src -r -y --rosdistro "${DOTFILES_ROS_DISTRO:-jazzy}" "$@"
)

ros_clean() (
  local workspace name target
  local -a targets=()
  if [[ $# != 1 || $1 != --yes ]]; then
    printf 'Usage: ros_clean --yes\nRemoves only marked colcon build/install/log directories in the selected workspace.\n' >&2
    return 2
  fi
  workspace=$(_ros_workspace) || return
  # Validate the entire operation before deleting anything. Never follow output symlinks.
  for name in build install log; do
    target=$workspace/$name
    [[ -e $target || -L $target ]] || continue
    if [[ -L $target || ! -d $target || ! -f $target/COLCON_IGNORE || -L $target/COLCON_IGNORE ]]; then
      printf 'Refusing to remove an unmarked or linked directory: %s\n' "$target" >&2
      return 1
    fi
    [[ $(builtin cd -- "$target" && pwd -P) == "$workspace/$name" ]] || return 1
    targets+=("$target")
  done
  if (( ${#targets[@]} )); then
    printf 'Removing colcon outputs from %s\n' "$workspace"
    command rm -rf -- "${targets[@]}"
  fi
)
